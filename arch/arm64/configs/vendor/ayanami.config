# CONFIG_AUDIT is not set
# CONFIG_LOCALVERSION_AUTO is not set

CONFIG_BOEFFLA_WL_BLOCKER=y

CONFIG_CPU_IDLE_GOV_TEO=y

CONFIG_ZRAM_DEF_COMP_LZ4=y

CONFIG_LITTLE_CPU_MASK=15
CONFIG_BIG_CPU_MASK=240
CONFIG_PRIME_CPU_MASK=0

# IRQ
CONFIG_IRQ_SBALANCE=y
CONFIG_IRQ_SBALANCE_POLL_MSEC=20000
CONFIG_IRQ_SBALANCE_THRESH=1024
CONFIG_SBALANCE_EXCLUDE_CPUS="3,7"

# sched
# CONFIG_SCHED_DEBUG is not set
# Misc 
CONFIG_FAKE_UNAME_5_10=y

# KSU
CONFIG_KSU=y
CONFIG_KSU_DEBUG=n
# CONFIG_KSU_TRACEPOINT_HOOK is not set
CONFIG_KSU_MANUAL_HOOK=y
