# ARM64
CONFIG_ARM64_CRYPTO=y
# CONFIG_ARM64_SVE is not set


# Networking
# CONFIG_PPP is not set

# Block
# CONFIG_BLK_DEV_RAM is not set


# Charger & Regulator
# CONFIG_QPNP_SMBLITE is not set
# CONFIG_REGULATOR_PM8008 is not set
# CONFIG_SMB1355_SLAVE_CHARGER is not set
# CONFIG_SMB1398_CHARGER is not set



# Compiler
# CONFIG_CFI_CLANG is not set
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE_O3=y



# Debug
# CONFIG_BLK_DEBUG_FS is not set
# CONFIG_BT_DEBUGFS is not set
CONFIG_DEBUG_LIST=y
# CONFIG_DEBUG_FS is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_FRAME_VECTOR is not set
# CONFIG_IPC_LOGGING is not set
CONFIG_LOG_BUF_SHIFT=21
# CONFIG_MSM_IDLE_STATS is not set
# CONFIG_PAGE_EXTENSION is not set
# CONFIG_PAGE_OWNER is not set
# CONFIG_SLUB_DEBUG is not set



# ION / Memory
# CONFIG_DM_CRYPT is not set
# CONFIG_ION_POOL_AUTO_REFILL is not set



# KSU
CONFIG_KSU=y
CONFIG_KSU_DEBUG=n
CONFIG_KSU_MANUAL_HOOK=y
# CONFIG_KSU_TRACEPOINT_HOOK is not set

# LEDs
# CONFIG_LEDS_AW2016 is not set
# CONFIG_LEDS_GPIO is not set
# CONFIG_LEDS_QPNP_VIBRATOR_LDO is not set



# Scheduler
# CONFIG_SCHEDSTATS is not set
# CONFIG_SCHED_CORE_CTL is not set
# CONFIG_SCHED_WALT is not set
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
CONFIG_PELT_COMPATIBILITY_LAYER=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_BUCKETS_COUNT=20



# RCU
CONFIG_RCU_BOOST=y
CONFIG_RCU_LAZY=y



# Security
CONFIG_ARCH_MMAP_RND_BITS=20
CONFIG_SECURITY_DMESG_RESTRICT=y



# Misc
# CONFIG_HARDEN_EL2_VECTORS is not set
# CONFIG_IKHEADERS is not set
CONFIG_LD_DEAD_CODE_DATA_ELIMINATION=y
# CONFIG_MODULES is not set
# CONFIG_MODULE_UNLOAD is not set
# CONFIG_MODVERSIONS is not set
# CONFIG_SLUB_CPU_PARTIAL is not set



# QCOM
# CONFIG_BALANCE_ANON_FILE_RECLAIM is not set
# CONFIG_CPU_BOOST is not set
# CONFIG_CPU_FREQ_STAT is not set
# CONFIG_CPU_FREQ_TIMES is not set
# CONFIG_DVB_MPQ is not set
# CONFIG_DVB_MPQ_DEMUX is not set
# CONFIG_DVB_MPQ_SW is not set
# CONFIG_MSM_BOOT_STATS is not set
# CONFIG_MSM_EVENT_TIMER is not set
# CONFIG_MSM_RDBG is not set
# CONFIG_QCOM_DCC_V2 is not set
# CONFIG_QCOM_MEMORY_DUMP_V2 is not set
# CONFIG_QCOM_QHEE_ENABLE_MEM_PROTECTION is not set
# CONFIG_QTI_CPU_ISOLATE_COOLING_DEVICE is not set
# CONFIG_QTI_RPM_SMD_COOLING_DEVICE is not set
# CONFIG_QTI_RPM_STATS_LOG is not set
# CONFIG_QTI_THERMAL_LIMITS_DCVS is not set
# CONFIG_SCSI_CONSTANTS is not set
# CONFIG_THERMAL_EMERGENCY_POWEROFF_DELAY_MS is not set
# CONFIG_THERMAL_STATISTICS is not set
# CONFIG_QCOM_INITIAL_LOGBUF is not set
# CONFIG_MSM_PERFORMANCE is not set



# Kernel configurations for full DroidSpaces support for non-GKI
# Copyright (C) 2026 ravindu644 <droidcasts@protonmail.com>

# IPC mechanisms
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Core namespace support
CONFIG_PID_NS=y
CONFIG_IPC_NS=y

# Device filesystem support
CONFIG_DEVTMPFS=y
